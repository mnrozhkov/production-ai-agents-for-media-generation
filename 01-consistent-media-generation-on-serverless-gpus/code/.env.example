# Set these in your shell; never commit real tokens. Scripts do not auto-load .env.
BASE_URL=https://YOUR-ENDPOINT-HOST
TOKEN=YOUR-ENDPOINT-TOKEN
ENDPOINT_IMAGE=copy-exact-image-from-console
WORKER_IMAGE=your-registry/sana-worker@sha256:YOUR_DIGEST
BUCKET=your-existing-bucket
RUN_ID=your-unique-run-id
JOB_TIMEOUT=1h

# emma_gift.ipynb: one Endpoint per section. The notebook reads these from code/.env
# and asks for (then saves) any that are missing. Leave a token empty if auth is off.
SANA_BASE_URL=https://YOUR-SANA-ENDPOINT-HOST
SANA_TOKEN=YOUR-SANA-ENDPOINT-TOKEN
QWEN_EDIT_BASE_URL=https://YOUR-QWEN-IMAGE-EDIT-ENDPOINT-HOST
QWEN_EDIT_TOKEN=YOUR-QWEN-IMAGE-EDIT-ENDPOINT-TOKEN
KOKORO_BASE_URL=https://YOUR-KOKORO-ENDPOINT-HOST
KOKORO_TOKEN=YOUR-KOKORO-ENDPOINT-TOKEN
ACE_STEP_BASE_URL=https://YOUR-ACE-STEP-ENDPOINT-HOST
ACE_STEP_TOKEN=YOUR-ACE-STEP-ENDPOINT-TOKEN
WAN22_I2V_BASE_URL=https://YOUR-WAN22-I2V-ENDPOINT-HOST
WAN22_I2V_TOKEN=YOUR-WAN22-I2V-ENDPOINT-TOKEN
